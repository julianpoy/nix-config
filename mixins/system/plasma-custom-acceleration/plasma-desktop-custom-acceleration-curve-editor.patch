diff --git a/kcms/mouse/ui/AccelerationCurve.qml b/kcms/mouse/ui/AccelerationCurve.qml
new file mode 100644
index 0000000000..0b7d7fd1c9
--- /dev/null
+++ b/kcms/mouse/ui/AccelerationCurve.qml
@@ -0,0 +1,709 @@
+/*
+    SPDX-FileCopyrightText: 2026 KDE contributors
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Controls as QQC2
+import QtQuick.Layouts
+import QtQuick.Shapes
+
+import org.kde.kirigami as Kirigami
+
+Item {
+    id: root
+    clip: true
+    implicitHeight: Kirigami.Units.gridUnit * 16
+
+    property string curvePoints: ""
+    signal curveChanged(string points)
+
+    property int modelRev: 0
+
+    // Live speed from evdev (set by parent via device.speedMonitor)
+    property real liveSpeed: 0
+    property real peakSpeed: 0
+
+    // Data ranges (auto-computed, user can expand via +/- buttons)
+    property real maxX: 40
+    property real maxY: 1.2
+    property real userMaxX: 0  // user override minimum (0 = auto only)
+    property real userMaxY: 0
+
+    // Extension slope: sensitivity change per input speed unit beyond P3.
+    // 0 = flat (constant sensitivity), >0 = rising, <0 = falling
+    property real extensionSlope: 0.0
+
+    // Arrow tip: constant pixel length beyond P3, direction follows slope
+    readonly property real arrowPixelLen: 70
+
+    // Scale: data units per arrowPixelLen in the slope direction
+    readonly property real _arrowScale: {
+        var dxPix = pw / maxX
+        var dyPix = extensionSlope * ph / maxY
+        var pixLen = Math.sqrt(dxPix * dxPix + dyPix * dyPix)
+        return pixLen > 0.001 ? arrowPixelLen / pixLen : arrowPixelLen * maxX / pw
+    }
+
+    readonly property real arrowTipX: pts.count >= 4 ? pts.get(3).px + _arrowScale : 50
+    readonly property real arrowTipY: pts.count >= 4
+        ? Math.max(0, pts.get(3).py + _arrowScale * extensionSlope) : 1.0
+
+    // Layout
+    readonly property real lm: 50
+    readonly property real rm: 20
+    readonly property real tm: 12
+    readonly property real bm: 40  // space for X tick labels + title
+    readonly property real pw: Math.max(1, width - lm - rm)
+    readonly property real ph: Math.max(1, height - tm - bm)
+    readonly property real ptR: 7
+
+    // Axis tick arrays (computed once, shared by grid lines + labels)
+    readonly property var yTicks: {
+        var step = maxY <= 2 ? 0.2 : (maxY <= 5 ? 0.5 : (maxY <= 20 ? 2.0 : 5.0))
+        var arr = []
+        for (var v = 0; v <= maxY + 0.001; v += step)
+            arr.push(Math.round(v * 100) / 100)
+        return arr
+    }
+    readonly property var xTicks: {
+        var step = maxX <= 20 ? 5 : (maxX <= 100 ? 10 : (maxX <= 300 ? 50 : 100))
+        var arr = []
+        for (var v = 0; v <= maxX; v += step) arr.push(v)
+        return arr
+    }
+
+    // Points: exactly 4 for a cubic Bézier
+    //   index 0: P0 — start anchor (ON curve)
+    //   index 1: C1 — first control handle (OFF curve)
+    //   index 2: C2 — second control handle (OFF curve)
+    //   index 3: P3 — end anchor (ON curve)
+    // Y values are sensitivity (acceleration factor).
+    // 1.0 = pointer matches physical movement, <1.0 = decelerated, >1.0 = accelerated.
+    ListModel { id: pts }
+
+    // ── Coordinate mapping ──────────────────────────────────────
+    function toPixX(v: real): real { return lm + (v / maxX) * pw }
+    function toPixY(v: real): real { return tm + ph - (v / maxY) * ph }
+    function toDataX(p: real): real { return Math.max(0, (p - lm) / pw * maxX) }
+    function toDataY(p: real): real { return Math.max(0, (tm + ph - p) / ph * maxY) }
+
+    // Binding-friendly point accessors (touch modelRev to re-evaluate on drag)
+    function px(i: int): real { modelRev; return pts.count >= 4 ? toPixX(pts.get(i).px) : 0 }
+    function py(i: int): real { modelRev; return pts.count >= 4 ? toPixY(pts.get(i).py) : 0 }
+
+    // ── Cubic Bézier evaluation ─────────────────────────────────
+    function bezierAt(t: real): var {
+        if (pts.count < 4) return {x: 0, y: 0}
+        var p0 = pts.get(0), p1 = pts.get(1), p2 = pts.get(2), p3 = pts.get(3)
+        var u = 1 - t
+        return {
+            x: u*u*u*p0.px + 3*u*u*t*p1.px + 3*u*t*t*p2.px + t*t*t*p3.px,
+            y: Math.max(0, u*u*u*p0.py + 3*u*u*t*p1.py + 3*u*t*t*p2.py + t*t*t*p3.py)
+        }
+    }
+
+    // ── Arrowhead triangle points (direction-aware) ─────────────
+    function arrowHeadPoints(): list<point> {
+        if (pts.count < 4) return [Qt.point(0, 0), Qt.point(0, 0)]
+        var sx = toPixX(pts.get(3).px)
+        var sy = toPixY(pts.get(3).py)
+        var tx = toPixX(arrowTipX)
+        var ty = toPixY(arrowTipY)
+        var dx = tx - sx, dy = ty - sy
+        var len = Math.sqrt(dx * dx + dy * dy)
+        if (len < 2) return [Qt.point(0, 0), Qt.point(0, 0)]
+        var ux = dx / len, uy = dy / len   // unit vector along arrow
+        var wx = -uy, wy = ux              // perpendicular
+        var bx = tx - ux * 10, by = ty - uy * 10
+        return [
+            Qt.point(tx, ty),
+            Qt.point(bx + wx * 5, by + wy * 5),
+            Qt.point(bx - wx * 5, by - wy * 5),
+            Qt.point(tx, ty)
+        ]
+    }
+
+    // ── Live speed fill polygon (area under curve from 0 to liveSpeed) ──
+    function liveSpeedFillPath(): list<point> {
+        var path = []
+        if (pts.count < 4 || liveSpeed < 0.1) return [Qt.point(0, 0), Qt.point(0, 0)]
+        var xMax = Math.min(liveSpeed, maxX)
+        var p3x = pts.get(3).px
+        var p3y = pts.get(3).py
+        // Bottom-left corner
+        path.push(Qt.point(toPixX(0), toPixY(0)))
+        // Along the Bézier curve
+        var steps = 40
+        var reachedP3 = false
+        for (var i = 0; i <= steps; i++) {
+            var t = i / steps
+            var pt = bezierAt(t)
+            var boundary = Math.min(xMax, p3x)
+            if (pt.x > boundary) {
+                var prevPt = bezierAt((i - 1) / steps)
+                var frac = (prevPt.x < boundary && pt.x > prevPt.x)
+                    ? (boundary - prevPt.x) / (pt.x - prevPt.x) : 1
+                var interpY = prevPt.y + frac * (pt.y - prevPt.y)
+                path.push(Qt.point(toPixX(boundary), toPixY(interpY)))
+                reachedP3 = (boundary === p3x)
+                break
+            }
+            path.push(Qt.point(toPixX(pt.x), toPixY(pt.y)))
+        }
+        // If liveSpeed extends past P3, follow the extension slope
+        if (xMax > p3x) {
+            if (!reachedP3) {
+                path.push(Qt.point(toPixX(p3x), toPixY(p3y)))
+            }
+            var extEndY = Math.max(0, p3y + extensionSlope * (xMax - p3x))
+            path.push(Qt.point(toPixX(xMax), toPixY(extEndY)))
+        }
+        // Down to bottom at xMax
+        path.push(Qt.point(toPixX(xMax), toPixY(0)))
+        // Close back to origin
+        path.push(Qt.point(toPixX(0), toPixY(0)))
+        return path
+    }
+
+    // ── Parse / Serialize ───────────────────────────────────────
+    // libinput stores output speed: "step:y0,y1,...,yn"
+    // We display sensitivity (factor): sensitivity = output_speed / input_speed
+    function parseCurve(str: string): void {
+        pts.clear()
+        extensionSlope = 0
+        if (!str || str.length === 0) {
+            // Default: S-curve from low sensitivity at rest to full at speed
+            pts.append({px: 0, py: 0.3, anchor: true})
+            pts.append({px: 10, py: 0.5, anchor: false})
+            pts.append({px: 30, py: 1.0, anchor: false})
+            pts.append({px: 40, py: 1.0, anchor: true})
+        } else {
+            var parts = str.split(":")
+            if (parts.length === 2) {
+                var step = parseFloat(parts[0])
+                var vals = parts[1].split(",")
+                var n = vals.length
+
+                // Convert output speed values to sensitivity factors
+                var factors = []
+                for (var i = 0; i < n; i++) {
+                    var v = parseFloat(vals[i])
+                    if (i === 0) {
+                        factors.push(n > 1 ? parseFloat(vals[1]) / step : 1.0)
+                    } else {
+                        factors.push(v / (i * step))
+                    }
+                }
+
+                var curveEnd = n - 1
+
+                // Fit Bézier to points 0..curveEnd
+                var xEnd = curveEnd * step
+                var p0y = factors[0]
+                var p3y = factors[curveEnd]
+
+                var idx1 = Math.round(curveEnd / 3)
+                var idx2 = Math.round(2 * curveEnd / 3)
+                var y1 = factors[idx1]
+                var y2 = factors[idx2]
+
+                var a = 27 * y1 - 8 * p0y - p3y
+                var b = 27 * y2 - p0y - 8 * p3y
+                var cp1y = (2 * a - b) / 18
+                var cp2y = (2 * b - a) / 18
+
+                pts.append({px: 0, py: Math.max(0, p0y), anchor: true})
+                pts.append({px: xEnd / 3, py: Math.max(0, cp1y), anchor: false})
+                pts.append({px: 2 * xEnd / 3, py: Math.max(0, cp2y), anchor: false})
+                pts.append({px: xEnd, py: Math.max(0, p3y), anchor: true})
+            }
+        }
+        refreshRanges()
+        modelRev++
+    }
+
+    function refreshRanges(): void {
+        var mx = 5, my = 1.0
+        for (var i = 0; i < pts.count; i++) {
+            var p = pts.get(i)
+            if (p.px > mx) mx = p.px
+            if (p.py > my) my = p.py
+        }
+        for (var t = 0; t <= 1; t += 0.05) {
+            var pt = bezierAt(t)
+            if (pt.y > my) my = pt.y
+        }
+        // Arrow has constant pixel length — don't include in auto-range
+        // Bare minimum to keep all control points visible
+        var minX = Math.ceil(mx)
+        var minY = Math.ceil(my * 10) / 10
+        // Padded initial range (used when user hasn't manually zoomed)
+        var xStep = mx <= 10 ? 5 : (mx <= 50 ? 10 : 50)
+        var autoX = Math.max(10, Math.ceil(mx * 1.15 / xStep) * xStep)
+        var autoY = Math.max(1.2, Math.ceil(my * 1.1 * 2) / 2)
+        // userMax > 0 means user has zoomed; clamp to point minima only
+        maxX = userMaxX > 0 ? Math.max(minX, userMaxX) : autoX
+        maxY = userMaxY > 0 ? Math.max(minY, userMaxY) : autoY
+    }
+
+    function serializeCurve(): string {
+        if (pts.count < 4) return ""
+        var xEnd = pts.get(3).px
+        if (xEnd <= 0) return ""
+
+        // Dense sampling of the Bézier (sensitivity values)
+        var numT = 200
+        var samples = []
+        for (var i = 0; i <= numT; i++) {
+            samples.push(bezierAt(i / numT))
+        }
+
+        // Fixed step based on Bézier range
+        var numBezier = Math.min(40, Math.max(8, Math.round(xEnd / 2) + 1))
+        var step = xEnd / (numBezier - 1)
+        var out = []
+        var sIdx = 0
+        var p3y = pts.get(3).py
+
+        // Bézier region
+        for (var j = 0; j < numBezier; j++) {
+            var targetX = j * step
+            while (sIdx < samples.length - 1 && samples[sIdx + 1].x <= targetX)
+                sIdx++
+            var sensitivity
+            if (sIdx >= samples.length - 1) {
+                sensitivity = samples[samples.length - 1].y
+            } else {
+                var s0 = samples[sIdx], s1 = samples[sIdx + 1]
+                var frac = (s1.x - s0.x) > 0 ? (targetX - s0.x) / (s1.x - s0.x) : 0
+                sensitivity = s0.y + frac * (s1.y - s0.y)
+            }
+            var outputSpeed = Math.max(0, sensitivity) * targetX
+            out.push(String(outputSpeed))
+        }
+
+        // Extension arrow is visual-only — libinput extrapolates beyond the last point
+        return String(step) + ":" + out.join(",")
+    }
+
+    // Don't react to curvePoints changes — D-Bus feedback causes lossy re-parse.
+    // Parent must call loadCurve() explicitly on device switch or preset selection.
+    function loadCurve(str: string): void {
+        userMaxX = 0
+        userMaxY = 0
+        parseCurve(str)
+    }
+    Component.onCompleted: parseCurve(curvePoints)
+
+    // ═══════════════════════ VISUALS ═══════════════════════════
+
+    // Plot background
+    Rectangle {
+        x: root.lm; y: root.tm
+        width: root.pw; height: root.ph
+        color: Qt.alpha(Kirigami.Theme.backgroundColor, 0.4)
+        border.color: Qt.alpha(Kirigami.Theme.textColor, 0.2)
+        border.width: 1
+    }
+
+    // Horizontal grid lines + labels (Y axis — sensitivity scale)
+    Repeater {
+        model: root.yTicks
+        Item {
+            required property real modelData
+            // Grid line
+            Rectangle {
+                x: root.lm; y: root.toPixY(modelData)
+                width: root.pw; height: 1
+                color: Qt.alpha(Kirigami.Theme.textColor,
+                               Math.abs(modelData - 1.0) < 0.01 ? 0.35 : 0.1)
+            }
+            // Label
+            QQC2.Label {
+                x: root.lm - width - 8
+                y: root.toPixY(modelData) - height / 2
+                text: modelData.toFixed(1)
+                font: Kirigami.Theme.smallFont
+            }
+        }
+    }
+
+    // Vertical grid lines + labels (X axis — input speed)
+    Repeater {
+        model: root.xTicks
+        Item {
+            required property real modelData
+            // Grid line
+            Rectangle {
+                x: root.toPixX(modelData); y: root.tm
+                width: 1; height: root.ph
+                color: Qt.alpha(Kirigami.Theme.textColor, 0.1)
+            }
+            // Label
+            QQC2.Label {
+                x: root.toPixX(modelData) - width / 2
+                y: root.tm + root.ph + 4
+                text: String(Math.round(modelData))
+                font: Kirigami.Theme.smallFont
+            }
+        }
+    }
+
+    // ── All curve paths in a single Shape (leaner scene graph) ──
+    Shape {
+        anchors.fill: parent
+
+        // P0 → C1 tangent line
+        ShapePath {
+            strokeColor: Qt.alpha(Kirigami.Theme.textColor, 0.4)
+            strokeWidth: 1
+            fillColor: "transparent"
+            strokeStyle: ShapePath.DashLine
+            dashPattern: [4, 3]
+            startX: root.px(0); startY: root.py(0)
+            PathLine { x: root.px(1); y: root.py(1) }
+        }
+
+        // C1 → C2 connector line
+        ShapePath {
+            strokeColor: Qt.alpha(Kirigami.Theme.textColor, 0.4)
+            strokeWidth: 1
+            fillColor: "transparent"
+            strokeStyle: ShapePath.DashLine
+            dashPattern: [4, 3]
+            startX: root.px(1); startY: root.py(1)
+            PathLine { x: root.px(2); y: root.py(2) }
+        }
+
+        // C2 → P3 tangent line
+        ShapePath {
+            strokeColor: Qt.alpha(Kirigami.Theme.textColor, 0.4)
+            strokeWidth: 1
+            fillColor: "transparent"
+            strokeStyle: ShapePath.DashLine
+            dashPattern: [4, 3]
+            startX: root.px(2); startY: root.py(2)
+            PathLine { x: root.px(3); y: root.py(3) }
+        }
+
+        // Bézier curve
+        ShapePath {
+            strokeColor: Kirigami.Theme.highlightColor
+            strokeWidth: 2.5
+            fillColor: "transparent"
+            startX: root.px(0); startY: root.py(0)
+            PathCubic {
+                control1X: root.px(1); control1Y: root.py(1)
+                control2X: root.px(2); control2Y: root.py(2)
+                x: root.px(3); y: root.py(3)
+            }
+        }
+
+        // Extension line from P3 → arrow tip
+        ShapePath {
+            strokeColor: Kirigami.Theme.highlightColor
+            strokeWidth: 2.5
+            fillColor: "transparent"
+            startX: root.px(3); startY: root.py(3)
+            PathLine {
+                x: { root.modelRev; return root.toPixX(root.arrowTipX) }
+                y: { root.modelRev; return root.toPixY(root.arrowTipY) }
+            }
+        }
+
+        // Arrowhead (direction-aware filled triangle)
+        ShapePath {
+            strokeColor: "transparent"
+            fillColor: Kirigami.Theme.highlightColor
+            PathPolyline {
+                path: { root.modelRev; return root.arrowHeadPoints() }
+            }
+        }
+    }
+
+    // ── Control points with per-delegate DragHandler + HoverHandler ──
+    Repeater {
+        model: pts
+        delegate: Rectangle {
+            id: dot
+            required property int index
+            required property real px
+            required property real py
+            required property bool anchor
+
+            readonly property bool pressed: dragHandler.active || tapHandler.pressed
+            readonly property real r: root.ptR
+                * (anchor ? 1.0 : 0.85)
+                * (pressed ? 1.3 : (hoverHandler.hovered ? 1.15 : 1.0))
+
+            x: root.toPixX(px) - r
+            y: root.toPixY(py) - r
+            width: r * 2; height: r * 2; radius: r
+
+            color: anchor ? Kirigami.Theme.highlightColor
+                          : Kirigami.Theme.backgroundColor
+            border.color: anchor
+                ? Qt.darker(Kirigami.Theme.highlightColor, 1.3)
+                : (pressed ? Qt.lighter(Kirigami.Theme.highlightColor, 1.3)
+                           : (hoverHandler.hovered ? Kirigami.Theme.highlightColor
+                                      : Qt.darker(Kirigami.Theme.highlightColor, 1.1)))
+            border.width: anchor ? 2 : 2.5
+
+            QQC2.ToolTip.text: dot.py.toFixed(2)
+            QQC2.ToolTip.visible: hoverHandler.hovered || pressed
+
+            HoverHandler {
+                id: hoverHandler
+            }
+
+            TapHandler {
+                id: tapHandler
+                gesturePolicy: TapHandler.DragThreshold
+            }
+
+            DragHandler {
+                id: dragHandler
+                target: null
+                dragThreshold: 0
+
+                property real startPx
+                property real startPy
+
+                onActiveChanged: {
+                    if (active) {
+                        startPx = dot.px
+                        startPy = dot.py
+                    } else {
+                        root.modelRev++
+                        root.curveChanged(root.serializeCurve())
+                    }
+                }
+
+                onActiveTranslationChanged: {
+                    if (!active) return
+
+                    var dxData = activeTranslation.x / root.pw * root.maxX
+                    var dyData = -(activeTranslation.y / root.ph * root.maxY)
+
+                    var newX = Math.round(Math.max(0, startPx + dxData) * 100) / 100
+                    var newY = Math.round(Math.max(0, startPy + dyData) * 1000) / 1000
+
+                    // Enforce cubic Bézier X-monotonicity:
+                    //   bx >= ax, cx <= dx, (bx-ax)(dx-cx) >= max(bx-cx, 0)^2
+                    // On violation, solve for nearest valid X on the boundary.
+                    var ax = pts.get(0).px
+                    var bx = pts.get(1).px
+                    var cx = pts.get(2).px
+                    var dx = pts.get(3).px
+
+                    if (dot.index === 0) {
+                        pts.set(0, {px: 0, py: newY, anchor: true})
+                    } else if (dot.index === 3) {
+                        // D: clamp dx >= cx, dx >= 5, then discriminant
+                        var newDx = Math.max(cx, Math.max(5, newX))
+                        var gap = Math.max(bx - cx, 0)
+                        if (gap > 0 && bx > ax) {
+                            var minDx = cx + gap * gap / (bx - ax)
+                            newDx = Math.max(newDx, minDx)
+                        }
+                        pts.set(3, {px: Math.round(newDx * 100) / 100, py: newY, anchor: true})
+                    } else if (dot.index === 1) {
+                        // B: clamp bx >= ax, then solve quadratic boundary
+                        var newBx = Math.max(ax, newX)
+                        if (newBx > cx) {
+                            var lhs = (newBx - ax) * (dx - cx)
+                            var rhs = (newBx - cx) * (newBx - cx)
+                            if (lhs < rhs) {
+                                // Solve: p^2 - p*(cx+dx) + cx^2 + ax*(dx-cx) = 0
+                                var disc = (cx + dx) * (cx + dx) - 4 * (cx * cx + ax * (dx - cx))
+                                if (disc >= 0)
+                                    newBx = ((cx + dx) + Math.sqrt(disc)) / 2
+                                else
+                                    newBx = dot.px
+                            }
+                        }
+                        pts.set(1, {px: Math.round(newBx * 100) / 100, py: newY, anchor: false})
+                    } else {
+                        // C: clamp cx <= dx, then solve quadratic boundary
+                        var newCx = Math.min(dx, newX)
+                        if (bx > newCx) {
+                            var lhs = (bx - ax) * (dx - newCx)
+                            var rhs = (bx - newCx) * (bx - newCx)
+                            if (lhs < rhs) {
+                                // Solve: q^2 - q*(ax+bx) + bx^2 + dx*(ax-bx) = 0
+                                var disc = (ax + bx) * (ax + bx) - 4 * (bx * bx + dx * (ax - bx))
+                                if (disc >= 0)
+                                    newCx = ((ax + bx) - Math.sqrt(disc)) / 2
+                                else
+                                    newCx = dot.px
+                            }
+                        }
+                        pts.set(2, {px: Math.round(newCx * 100) / 100, py: newY, anchor: false})
+                    }
+
+                    root.modelRev++
+                }
+            }
+        }
+    }
+
+    // ── Arrow tip handle (draggable — controls extension slope) ──
+    Rectangle {
+        id: arrowHandle
+        visible: pts.count >= 4
+
+        readonly property bool pressed: arrowDrag.active || arrowTap.pressed
+        readonly property real r: root.ptR * 0.85
+            * (pressed ? 1.3 : (arrowHover.hovered ? 1.15 : 1.0))
+
+        x: root.toPixX(root.arrowTipX) - r
+        y: root.toPixY(root.arrowTipY) - r
+        width: r * 2; height: r * 2; radius: r
+
+        color: Kirigami.Theme.backgroundColor
+        border.color: pressed ? Qt.lighter(Kirigami.Theme.highlightColor, 1.3)
+                      : (arrowHover.hovered ? Kirigami.Theme.highlightColor
+                                 : Qt.darker(Kirigami.Theme.highlightColor, 1.1))
+        border.width: 2.5
+
+        QQC2.ToolTip.text: root.arrowTipY.toFixed(2)
+        QQC2.ToolTip.visible: arrowHover.hovered || pressed
+
+        HoverHandler { id: arrowHover }
+        TapHandler { id: arrowTap; gesturePolicy: TapHandler.DragThreshold }
+
+        DragHandler {
+            id: arrowDrag
+            target: null
+            dragThreshold: 0
+
+            property real startTipX
+            property real startTipY
+
+            onActiveChanged: {
+                if (active) {
+                    startTipX = root.arrowTipX
+                    startTipY = root.arrowTipY
+                } else {
+                    root.modelRev++
+                    root.curveChanged(root.serializeCurve())
+                }
+            }
+
+            onActiveTranslationChanged: {
+                if (!active || pts.count < 4) return
+                var p3 = pts.get(3)
+                // New tip pixel position = original tip + drag translation
+                var newPixX = root.toPixX(startTipX) + activeTranslation.x
+                var newPixY = root.toPixY(startTipY) + activeTranslation.y
+                // Direction from P3 in data space
+                var dxData = (newPixX - root.toPixX(p3.px)) / root.pw * root.maxX
+                var dyData = -(newPixY - root.toPixY(p3.py)) / root.ph * root.maxY
+                // Only allow rightward arrows
+                if (dxData > 0.5)
+                    root.extensionSlope = Math.round(dyData / dxData * 10000) / 10000
+                root.modelRev++
+            }
+        }
+    }
+
+    // ── Live speed indicator (fill + edge line) ────────────────
+    Shape {
+        anchors.fill: parent
+        visible: root.liveSpeed > 0.3
+
+        // Shaded area under curve from 0 to liveSpeed
+        ShapePath {
+            fillColor: Qt.alpha(Kirigami.Theme.highlightColor, 0.15)
+            strokeColor: "transparent"
+            PathPolyline {
+                path: { root.modelRev; return root.liveSpeedFillPath() }
+            }
+        }
+
+        // Vertical edge line at current speed
+        ShapePath {
+            strokeColor: Qt.alpha(Kirigami.Theme.highlightColor, 0.6)
+            strokeWidth: 1.5
+            fillColor: "transparent"
+            startX: root.toPixX(Math.min(root.liveSpeed, root.maxX))
+            startY: root.tm
+            PathLine {
+                x: root.toPixX(Math.min(root.liveSpeed, root.maxX))
+                y: root.tm + root.ph
+            }
+        }
+    }
+
+    // Axis titles
+    QQC2.Label {
+        id: xAxisLabel
+        x: root.lm + root.pw / 2 - width / 2
+        y: root.tm + root.ph + 20
+        text: i18ndc("kcmmouse", "@label:axis", "Input speed")
+        font: Kirigami.Theme.smallFont
+    }
+
+    QQC2.Label {
+        x: 2
+        y: root.tm + root.ph / 2 + width / 2
+        text: i18ndc("kcmmouse", "@label:axis", "Sensitivity")
+        font: Kirigami.Theme.smallFont
+        rotation: -90
+        transformOrigin: Item.TopLeft
+    }
+
+    // ── Y axis zoom +/- buttons (left side) ──────────────────
+    QQC2.ToolButton {
+        x: 0; y: root.tm
+        width: 22; height: 22
+        text: "+"
+        font.pixelSize: 14
+        onClicked: {
+            root.userMaxY = root.maxY + 0.5
+            root.refreshRanges()
+        }
+    }
+    QQC2.ToolButton {
+        x: 0; y: root.tm + 24
+        width: 22; height: 22
+        text: "\u2212"  // minus sign
+        font.pixelSize: 14
+        onClicked: {
+            root.userMaxY = Math.max(0.5, root.maxY - 0.5)
+            root.refreshRanges()
+        }
+    }
+
+    // ── X axis zoom -/+ buttons (right-aligned to plot edge, same row as "Input speed") ──
+    QQC2.ToolButton {
+        x: root.lm + root.pw - 44
+        y: xAxisLabel.y + xAxisLabel.height / 2 - height / 2
+        width: 22; height: 22
+        text: "\u2212"
+        font.pixelSize: 14
+        onClicked: {
+            var step = root.maxX <= 10 ? 2 : (root.maxX <= 30 ? 5 : 10)
+            root.userMaxX = Math.max(1, root.maxX - step)
+            root.refreshRanges()
+        }
+    }
+    QQC2.ToolButton {
+        x: root.lm + root.pw - 22
+        y: xAxisLabel.y + xAxisLabel.height / 2 - height / 2
+        width: 22; height: 22
+        text: "+"
+        font.pixelSize: 14
+        onClicked: {
+            var step = root.maxX <= 10 ? 2 : (root.maxX <= 30 ? 5 : 10)
+            root.userMaxX = root.maxX + step
+            root.refreshRanges()
+        }
+    }
+
+    // Version label
+}
